{
    "name": "langsys-js-react-native",
    "version": "0.1.0",
    "description": "React Native binding for the Langsys translation SDK - hooks-first: the full t() catalog pipeline on Hermes, with injectable storage. Experimental.",
    "author": "Langsys",
    "license": "MIT",
    "homepage": "https://github.com/langsys/langsys-js-react-native",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/langsys/langsys-js-react-native.git"
    },
    "bugs": {
        "url": "https://github.com/langsys/langsys-js-react-native/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "build:watch": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "i18n",
        "l10n",
        "react-native",
        "expo",
        "hermes",
        "language",
        "localization",
        "internationalization",
        "translation",
        "langsys",
        "sdk"
    ],
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-native": ">=0.73.0"
    },
    "dependencies": {
        "langsys-js-typescript": "^0.4.2"
    },
    "devDependencies": {
        "@types/react": "^18.3.0",
        "prettier": "^3.3.0",
        "react": "^18.3.1",
        "tsup": "^8.4.0",
        "typescript": "^5.8.3"
    }
}
